# PostgreSQL connection string. Replace the placeholder locally; never commit real credentials.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/student_skill_tracker

# Local development settings. Production values are configured in the host's secret store.
APP_ENV=development
SERVE_FRONTEND=false

# Allowed local React development origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development convenience: create SQLAlchemy tables at API startup.
AUTO_CREATE_TABLES=true

# Optional server-side Groq integration. Never place the real key in frontend variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Generate a private key with Python secrets.token_urlsafe(48). Use at least 32 bytes; never commit it.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=ssdt_session
# false is for local HTTP development only; use true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
# Skill classification thresholds; production should match the deployed app's intended policy.
SKILL_GAP_THRESHOLD=60
SKILL_STRENGTH_THRESHOLD=80
